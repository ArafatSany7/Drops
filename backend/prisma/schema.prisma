generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                   String         @id @default(uuid())
  firstName            String
  lastName             String
  email                String         @unique
  phone                String?
  passwordHash         String?
  dob                  DateTime?
  gender               String?
  bloodGroup           String?
  district             String?
  isVerified           Boolean        @default(false)
  lastDonationDate     DateTime?
  googleId             String?        @unique
  role                 Role           @default(USER)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  availableForDonation Boolean        @default(true)
  requests             BloodRequest[]
  blogPosts            BlogPost[]
}

model BloodRequest {
  id               String   @id @default(uuid())
  patientName      String
  bloodGroupNeeded String
  hospitalName     String
  district         String
  urgencyLevel     String
  status           String   @default("ACTIVE")
  requesterId      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requester        User     @relation(fields: [requesterId], references: [id])
}

model ImpactStat {
  id               String   @id @default(uuid())
  livesSaved       Int      @default(0)
  activeDonors     Int      @default(0)
  districtsCovered Int      @default(0)
  lastUpdated      DateTime @default(now()) @updatedAt
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String
  category    String
  tags        String[] @default([])
  authorId    String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}
